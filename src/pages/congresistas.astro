---
import Layout from '../layouts/Layout.astro';
import InternalPageHero from '../components/sections/InternalPageHero.astro';
import Container from '../components/ui/Container.astro';
import CandidateCard from '../components/ui/CandidateCard.astro';
import Select from '../components/ui/Input/Select.astro';
import Input from '../components/ui/Input/Input.astro';
import Button from '../components/ui/Button/Button.astro';

const URL_DATA = import.meta.env.URL_DATA;
const URL_CANDIDATE_PICTURE = import.meta.env.URL_CANDIDATE_PICTURE;

const TEXT_PLACEHOLDER = 'Selecciono'

interface Candidate {
  id: number;
  picture: string;
  name: string;
  region: string;
  party: string;
  partyId: number;
  attendance: number;
  projects: number;
  applyTo: string;
  motions: number;
}

interface Region {
  id_ubigeo: string;
  nombre_ubigeo: string;
}

interface Party {
  id: number;
  name: string;
  picture: string;
}

let candidates: Candidate[] = [];
let regions: Region[] = [];
let parties: Party[] = [];

try {
  const [candRes, regRes, partyRes] = await Promise.all([
    fetch(`${URL_DATA}/candidate.json`),
    fetch(`${URL_DATA}/region.json`),
    fetch(`${URL_DATA}/party.json`),
  ]);
  candidates = await candRes.json();
  regions = await regRes.json();
  parties = await partyRes.json();
} catch (e) {
  console.error('Error fetching data:', e);
}

// Build unique apply-to values from candidates
const applyToOptions = ['Senador(a)', 'Diputado(a)'].sort();

// Map partyId -> picture path
const partyPictureMap = new Map(parties.map((p) => [p.id, p.picture]));

const URL_PARTY_PICTURE = import.meta.env.URL_PARTY_PICTURE;

const partyOptions = parties.map((p) => ({ label: p.name, value: p.name }));
const regionOptions = regions.map((r) => ({ label: r.nombre_ubigeo, value: r.nombre_ubigeo }));
const applyToSelectOptions = applyToOptions.map((a) => ({ label: a, value: a }));

const PAGE_SIZE = 9;
---

<Layout
  title="Candidatos — Observatorio de la Función Congresal"
  description="Conoce a tus candidatos, su desempeño y compromiso con el país."
>
  <InternalPageHero
    title="Candidatos"
    subtitle="Conoce a tus candidatos, su desempeño y compromiso con el país"
  />

  <section class="py-10 bg-gray-50 min-h-[60vh]">
    <Container>

      <!-- Search -->
      <div class="mb-5">
        <Input
          type="search"
          id="candidate-search"
          name="candidate-search"
          placeholder="Buscar por nombre"
          class="w-full"
          aria-label="Buscar candidato"
        />
      </div>

      <!-- Filters -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <Select
          id="filter-party"
          name="filter-party"
          placeholder={TEXT_PLACEHOLDER}
          label="Partido"
          options={partyOptions}
          aria-label="Filtrar por partido"
        />
        <Select
          id="filter-apply-to"
          name="filter-apply-to"
          placeholder={TEXT_PLACEHOLDER}
          label="Postula a"
          options={applyToSelectOptions}
          aria-label="Filtrar por cargo al que postula"
        />
        <Select
          id="filter-region"
          name="filter-region"
          placeholder={TEXT_PLACEHOLDER}
          label="Región"
          options={regionOptions}
          aria-label="Filtrar por región"
        />
      </div>

      <!-- Empty state -->
      <p id="candidates-empty" class="hidden text-center text-primary-gray-obs py-12">
        No se encontraron candidatos con los filtros aplicados.
      </p>

      <!-- Grid -->
      <div id="candidates-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {candidates.map((candidate, index) => (
          <div
            class:list={['candidate-item', index >= PAGE_SIZE ? 'hidden' : '']}
            data-name={candidate.name.toLowerCase()}
            data-party={candidate.party.toLowerCase()}
            data-region={candidate.region.toLowerCase()}
            data-apply-to={candidate.applyTo.toLowerCase()}
            data-index={index}
          >
            <CandidateCard
              id={candidate.id}
              picture={candidate.picture}
              name={candidate.name}
              region={candidate.region}
              party={candidate.party}
              partyId={candidate.partyId}
              attendance={candidate.attendance}
              motions={candidate.motions}
              projects={candidate.projects}
              applyTo={candidate.applyTo}
              pictureBase={URL_CANDIDATE_PICTURE}
              partyPicture={partyPictureMap.get(candidate.partyId)}
              partyPictureBase={URL_PARTY_PICTURE}
            />
          </div>
        ))}
      </div>

      <!-- Load more -->
      {candidates.length > PAGE_SIZE && (
        <div id="load-more-wrapper" class="mt-10 flex justify-center">
          <Button id="load-more-btn" variant="outline-dark" size="md" class="rounded-2xl">
            Ver más candidatos
          </Button>
        </div>
      )}

    </Container>
  </section>
</Layout>

<script>
  const TEXT_PLACEHOLDER = 'Selecciono';
  // --- Element references ---
  const searchInput = document.getElementById('candidate-search') as HTMLInputElement | null;
  const emptyState = document.getElementById('candidates-empty');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreWrapper = document.getElementById('load-more-wrapper');

  // Free-astro-components selects render native <select> elements
  const partySelect = document.getElementById('filter-party') as HTMLSelectElement | null;
  const applyToSelect = document.getElementById('filter-apply-to') as HTMLSelectElement | null;
  const regionSelect = document.getElementById('filter-region') as HTMLSelectElement | null;

  const PAGE_SIZE = 9;
  let currentVisible = PAGE_SIZE;

  function getAllItems(): HTMLElement[] {
    return Array.from(document.querySelectorAll('.candidate-item')) as HTMLElement[];
  }

  function getFilters() {
    return {
      query: (searchInput?.value ?? '').trim().toLowerCase(),
      party: (partySelect?.value ?? ''),
      applyTo: (applyToSelect?.value ?? ''),
      region: (regionSelect?.value ?? ''),
    };
  }

  function isFiltering({ query, party, applyTo, region }: ReturnType<typeof getFilters>) {
    return query.length > 0 || party !== '' || applyTo !== '' || region !== '';
  }

  function matchesApplyToFn(applyTo: string, filters: any) {
    return (filters.applyTo === '' || filters.applyTo === TEXT_PLACEHOLDER ||
      applyTo.toLowerCase() === filters.applyTo.toLowerCase() ||
      (filters.applyTo.toLowerCase() === 'senador(a)' && ['senador', 'senadora'].includes(applyTo.toLowerCase())) ||
      (filters.applyTo.toLowerCase() === 'diputado(a)' && ['diputado', 'diputada'].includes(applyTo.toLowerCase())));
  }
  
  function applyFilters() {
    const filters = getFilters();
    const filtering = isFiltering(filters);
    const items = getAllItems();

    let visibleCount = 0;

    items.forEach((item) => {
      const name = item.dataset.name ?? '';
      const party = item.dataset.party ?? '';
      const region = item.dataset.region ?? '';
      const applyTo = item.dataset.applyTo ?? '';
      const index = parseInt(item.dataset.index ?? '0', 10);

      const matchesQuery = filters.query === '' || name.includes(filters.query);
      const matchesParty = filters.party === '' || filters.party === TEXT_PLACEHOLDER || party === filters.party.toLowerCase();
      const matchesApplyTo = matchesApplyToFn(applyTo, filters);
      const matchesRegion = filters.region === '' || filters.region === TEXT_PLACEHOLDER || region === filters.region.toLowerCase();

      const matches = matchesQuery && matchesParty && matchesApplyTo && matchesRegion;

      if (filtering) {
        item.classList.toggle('hidden', !matches);
        if (matches) visibleCount++;
      } else {
        const show = index < currentVisible;
        item.classList.toggle('hidden', !show);
        if (show) visibleCount++;
      }
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }

    if (loadMoreWrapper) {
      loadMoreWrapper.classList.toggle('hidden', filtering);
    }
  }

  searchInput?.addEventListener('input', applyFilters);

  // The free-astro-components Select fires native 'change' on the underlying <select>
  partySelect?.addEventListener('change', applyFilters);
  applyToSelect?.addEventListener('change', applyFilters);
  regionSelect?.addEventListener('change', applyFilters);

  loadMoreBtn?.addEventListener('click', () => {
    const items = getAllItems();
    const newVisible = currentVisible + PAGE_SIZE;
    items.forEach((item) => {
      const index = parseInt(item.dataset.index ?? '0', 10);
      if (index >= currentVisible && index < newVisible) {
        item.classList.remove('hidden');
      }
    });
    currentVisible = newVisible;

    if (currentVisible >= items.length && loadMoreWrapper) {
      loadMoreWrapper.classList.add('hidden');
    }
  });
</script>
