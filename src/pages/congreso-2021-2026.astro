---
import Layout from "../layouts/Layout.astro";
import InternalPageHero from "../components/sections/InternalPageHero.astro";
import Container from "../components/ui/Container.astro";
import RepresentationWeeks from "../components/activity/RepresentationWeeks.astro";
import CongressNumbers from "../components/congreso/CongressNumbers.astro";
import CongressComposition2021 from "../components/congreso/CongressComposition2021.astro";
import BillsStatus from "../components/congreso/BillsStatus.astro";
import MotionsSummary from "../components/congreso/MotionsSummary.astro";
import CommissionsSummary from "../components/congreso/CommissionsSummary.astro";
import VotesSection from "../components/congreso/VotesSection.vue";
import type { MemberVotesData, PreviousData } from "../types/previous";

const URL_DATA = import.meta.env.URL_DATA_V2;

const [dataResult, votesResult] = await Promise.all([
  fetch(`${URL_DATA}/2021-2026.json`),
  fetch(`${URL_DATA}/2021-2026-votos.json`),
]);
const congressData: PreviousData = await dataResult.json();
const memberVotes: MemberVotesData = await votesResult.json();
---

<Layout
  title="Congreso 2021 – 2026 — Observatorio de la Función Congresal"
  description="Resumen de la composición, leyes aprobadas, hitos e indicadores del último Congreso unicameral, previo al sistema bicameral."
>
  <InternalPageHero
    title="Congreso 2021 - 2026"
    subtitle="Resumen de la composición, leyes aprobadas, hitos e indicadores del último Congreso unicameral, previo al sistema bicameral."
  />

  <div class="bg-dark-white-obs pb-16 md:pb-20">
    <CongressNumbers items={congressData.general} />
    {congressData.composition && <CongressComposition2021 data={congressData.composition} />}
    {congressData.bills && <BillsStatus data={congressData.bills} />}
    {congressData.motions && <MotionsSummary data={congressData.motions} />}
    {congressData.commissions && <CommissionsSummary data={congressData.commissions} />}

    {
      congressData.representation?.weeks && (
        <section class="pt-12 md:pt-14">
          <Container>
            <RepresentationWeeks data={congressData.representation.weeks} />
          </Container>
        </section>
      )
    }

    {
      congressData.votes && (
        <section class="pt-12 md:pt-14">
          <Container>
            <VotesSection client:visible data={congressData.votes} members={memberVotes} />
          </Container>
        </section>
      )
    }
  </div>
</Layout>
