---
import Layout from "../layouts/Layout.astro";
import InternalPageHero from "../components/sections/InternalPageHero.astro";
import Card from "../components/ui/Card/Card.astro";
import Container from "../components/ui/Container.astro";
import PartyPieChart from "../components/charts/PartyPieChart.vue";
import type { PreviousData } from "../types/previous";

const URL_DATA = import.meta.env.URL_DATA;

const datResult = await fetch(`${URL_DATA}/2021-2026.json`);
const congressData: PreviousData = await datResult.json();

const timelineEvents = [
  {
    year: "2021",
    title:
      "Inicio del período con Congreso unicameral y nuevo gobierno de Pedro Castillo",
  },
  {
    year: "2022",
    title:
      "Aprobación de la Ley de Reforma Política que incluye la bicameralidad",
  },
  {
    year: "2023",
    title: "Vacancia presidencial y asunción de Dina Boluarte como presidenta",
  },
  {
    year: "2024",
    title:
      "Referéndum de confirmación del sistema bicameral aprobado por la ciudadanía",
  },
  {
    year: "2025",
    title: "Convocatoria a elecciones generales bajo el nuevo sistema",
  },
  {
    year: "2026",
    title: "Instalación del primer Congreso bicameral desde 1993",
    isCurrent: true,
  },
];
---

<Layout
  title="Congreso 2021 – 2026 — Observatorio de la Función Congresal"
  description="Resumen de la composición, leyes aprobadas, hitos e indicadores del último Congreso unicameral, previo al sistema bicameral."
>
  <InternalPageHero
    title="Congreso 2021 – 2026"
    subtitle="Resumen de la composición, leyes aprobadas, hitos e indicadores del último Congreso unicameral, previo al sistema bicameral."
  />

  <section class="bg-dark-white-obs py-12 md:py-14">
    <Container>
      <p
        class="text-xs font-semibold text-gray-icon-obs uppercase tracking-wide mb-4"
      >
        Indicadores del período 2021-2026
      </p>
      <ul class="grid grid-cols-2 md:grid-cols-5 gap-6 mb-8">
        {
          congressData.general.map((item) => (
            <li class="bg-white rounded-2xl p-5 shadow-md">
              <span class="block text-3xl font-bold text-primary-blacks-obs">
                {item.value}
              </span>
              <span class="text-xs text-regular-gray-obs uppercase font-semibold">
                {item.label}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <Card>
          <h2 class="text-xs text-primary-gray-obs font-bold mb-4">
            Composición del Congreso 2021-2026
          </h2>
          <p class="text-xs text-primary-gray-obs mb-6">
            Unicameral · 130 escaños · Distribución inicial de bancadas
          </p>
          <div class="py-6">
            {
              congressData.composition && (
                <PartyPieChart
                  client:load
                  composition={congressData.composition}
                />
              )
            }
          </div>
        </Card>

        <Card>
          <h2 class="text-xs text-primary-gray-obs font-bold mb-4 uppercase">
            Hitos del período
          </h2>
          <ol class="relative flex flex-col gap-4">
            {
              timelineEvents.map((event) => (
                <li class="flex gap-4">
                  <div class="flex flex-col items-center">
                    <span class="w-3 h-3 rounded-full mt-0.5 shrink-0 bg-transparent border-2 border-primary-gray-obs" />
                    <div class="w-px flex-1 bg-light-gray-obs mt-1" />
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-primary-black-obs mb-1">
                      {event.year}
                    </p>
                    <p class="text-sm text-regular-gray-obs">
                      {event.title}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </Card>
      </div>

      <Card>
        <p
          class="text-xs text-primary-gray-obs font-bold mb-4 uppercase"
        >
          Contexto histórico
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-lg font-bold mb-3">
              La transición al bicameralismo
            </h3>
            <p class="text-sm text-primary-gray-obs leading-6">
              El período 2021–2026 fue uno de los más convulsos de la historia
              democrática peruana, con siete cambios de Primer Ministro, una
              vacancia presidencial y la asunción de una nueva presidenta a
              fines de 2022.
            </p>
            <p class="text-sm text-primary-gray-obs leading-6 mt-3">
              En medio de esta turbulencia política, el Congreso logró aprobar
              la reforma constitucional que restauró el bicameralismo.
            </p>
          </div>
          <div>
            <h3 class="text-lg font-bold mb-3">
              Por qué importa este historial
            </h3>
            <p class="text-sm text-primary-gray-obs leading-6 font-inter">
              Comprender el Congreso anterior es fundamental para evaluar el
              impacto del cambio institucional. El sistema unicameral generó
              leyes con menor deliberación y mayor inconsistencia técnica.
            </p>
            <p class="text-sm text-primary-gray-obs leading-6 font-inter mt-3">
              El Observatorio mantiene este archivo histórico para ciudadanos,
              investigadores y periodistas que estudian la evolución del sistema
              parlamentario peruano.
            </p>
          </div>
        </div>
      </Card>
    </Container>
  </section>
</Layout>
