---
import Layout from '../layouts/Layout.astro';
import InternalPageHero from '../components/sections/InternalPageHero.astro';
import Card from '../components/ui/Card/Card.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button/Button.astro';
import CongressCompositionCharts from '../components/sections/CongressCompositionCharts.astro';
import deputyIcon from '../assets/icons/deputy.svg?raw';
import senatorIcon from '../assets/icons/senator.svg?raw';
import browserIcon from '../assets/icons/browser.svg?raw';

const advantages = [
  'Mayor deliberación y calidad legislativa por doble revisión de proyectos.',
  'Representación diferenciada: regional (Diputados) y nacional (Senado).',
  'Mejor contrapeso institucional dentro del Legislativo.',
  'Mayor especialización parlamentaria en dos cámaras distintas.',
  'Reducción de leyes inconsultas o aprobadas precipitadamente.',
];

const chambers = [
  {
    name: 'Cámara de Diputados',
    seats: '130',
    icon: deputyIcon,
    badgeClass: 'bg-sky-blue-obs',
    numberClass: 'text-primary-blue-obs',
    description:
      'Primera cámara del Parlamento peruano. Representa a la ciudadanía a través de circunscripciones regionales proporcionales a la población.',
    requirements: 'Edad mínima: 25 años. Elegidos por 5 años con reelección por un período adicional.',
    functions: [
      'Presentar e iniciar proyectos de ley',
      'Aprobar el Presupuesto General de la República',
      'Fiscalizar al Poder Ejecutivo',
      'Nombrar al Defensor del Pueblo',
      'Interpelar ministros',
    ],
  },
  {
    name: 'Senado de la República',
    seats: '60',
    icon: senatorIcon,
    badgeClass: 'bg-sky-red-obs',
    numberClass: 'text-red-obs',
    description:
      'Cámara revisora. Elegida en circunscripción nacional única, representa la visión de conjunto del país. Ratifica tratados internacionales.',
    requirements: 'Edad mínima: 45 años. Elegidos por 5 años con reelección por un período adicional.',
    functions: [
      'Revisar leyes aprobadas por la Cámara de Diputados',
      'Ratificar tratados y convenios internacionales',
      'Aprobar el nombramiento de embajadores',
      'Autorizar el ingreso de tropas extranjeras',
      'Juzgar en antejuicio político',
    ],
  },
  {
    name: 'Parlamento Andino',
    seats: '5',
    icon: browserIcon,
    badgeClass: 'bg-light-green-obs',
    numberClass: 'text-green-obs',
    description:
      'Órgano deliberante de la Comunidad Andina de Naciones. Los representantes peruanos son elegidos en elección directa.',
    requirements: 'Edad mínima: 25 años. Período de 5 años en circunscripción nacional.',
    functions: [
      'Deliberar sobre integración andina',
      'Proponer normas comunitarias',
      'Fomentar relaciones parlamentarias regionales',
      'Promover la participación ciudadana en la CAN',
      'Impulsar libre circulación de personas y bienes',
    ],
  },
];

const timelineEvents = [
  {
    year: '1823',
    description: 'Primera Constitución peruana: sistema bicameral con Senado y Cámara de Diputados.',
  },
  {
    year: '1993',
    description: 'La Constitución de 1993 suprime el Senado y establece el Congreso unicameral de 120 escaños.',
  },
  {
    year: '2002',
    description: 'Primer intento de restaurar el bicameralismo. Reforma no prospera por falta de consenso.',
  },
  {
    year: '2018',
    description: 'Referéndum: ciudadanos rechazan la bicameralidad en consulta popular impulsada por PPK.',
  },
  {
    year: '2022',
    description: 'Nueva propuesta aprobada por el Congreso e incluida en reforma constitucional.',
  },
  {
    year: '2024',
    description: 'Referéndum de ratificación: 54.2% aprueba el retorno al sistema bicameral.',
  },
  {
    year: '2026',
    description: 'Primeras elecciones bajo el nuevo sistema. Instalación del Congreso bicameral el 26 de julio.',
  },
];
---

<Layout
  title="¿Qué es la bicameralidad? — Observatorio de la Función Congresal"
  description="Perú retorna al sistema de dos cámaras en 2026. Aquí te explicamos qué cambia y por qué importa."
>
  <InternalPageHero
    title="El nuevo sistema bicameral del Perú"
    subtitle="Tras más de 30 años de sistema unicameral, el Perú retorna a la tradición parlamentaria bicameral con la instalación del Congreso 2026-2031."
  />

  <!-- ¿Qué es la bicameralidad? -->
  <section class="bg-white py-12 md:py-16">
    <Container>
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-12">
        <div class="flex-1">
          <h2 class="text-2xl font-bold mb-4">¿Qué es la bicameralidad?</h2>
          <p class="leading-6 mb-4 text-primary-gray-obs">
            Un sistema bicameral es aquel en el que el Poder Legislativo está dividido en dos cámaras
            o asambleas: una cámara baja (Cámara de Diputados) y una cámara alta (Senado). Cada cámara
            tiene funciones específicas y complementarias.
          </p>
          <p class="leading-6 text-primary-gray-obs">
            La bicameralidad busca mejorar la calidad de las leyes mediante la doble revisión,
            representar de manera diferenciada a la ciudadanía, y generar un sistema de contrapesos
            dentro del propio Poder Legislativo.
          </p>
        </div>

        <div class="bg-lighter-gray-obs border border-solid border-lighter-border-gray-obs p-8 md:w-xl w-full">
          <h3 class="text-sm font-bold tracking-wide mb-5">
            Ventajas del sistema bicameral
          </h3>
          <ol class="flex flex-col gap-4">
            {advantages.map((advantage, index) => (
              <li class="flex items-center gap-3">
                <span
                  class="w-6 h-6 rounded-full bg-light-blue-obs text-primary-blue-obs text-xs font-bold flex items-center justify-center shrink-0"
                >
                  {index + 1}
                </span>
                <span class="text-sm text-primary-gray-obs leading-5">{advantage}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Container>
  </section>

  <!-- Las tres instancias parlamentarias -->
  <section class="bg-sky-blue-obs py-12 md:py-16">
    <Container>
      <h2 class="text-2xl font-bold mb-8">Las tres instancias parlamentarias</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {chambers.map((chamber) => (
          <Card class="flex flex-col gap-4">
            <div class="flex items-center justify-between">
              <span class={`w-12 h-12 rounded-xl flex items-center justify-center shrink-0 ${chamber.badgeClass}`}>
                <span class="w-5 h-5 svg-full" set:html={chamber.icon} />
              </span>
              <span class={`text-3xl font-inter font-bold ${chamber.numberClass}`}>{chamber.seats}</span>
            </div>

            <div>
              <h3 class="font-bold mb-2">{chamber.name}</h3>
              <p class="text-regular-gray-obs leading-5 mb-3">{chamber.description}</p>
              <p class="text-sm font-inter italic text-gray-icon-obs">{chamber.requirements}</p>
            </div>

            <div>
              <p class="text-sm font-bold text-primary-gray-obs uppercase tracking-wide mb-2">
                Funciones principales
              </p>
              <ul class="flex flex-col gap-1.5 list-disc pl-4">
                {chamber.functions.map((fn) => (
                  <li class="text-sm text-primary-gray-obs leading-5">{fn}</li>
                ))}
              </ul>
            </div>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  <!-- Nueva composición -->
  <section class="bg-white py-12 md:py-16">
    <Container>
      <h2 class="text-2xl font-bold text-center mb-8">Nueva composición</h2>
      <CongressCompositionCharts />
    </Container>
  </section>

  <!-- Cronología del bicameralismo -->
  <section class="bg-primary-blue-obs py-12 md:py-16">
    <Container>
      <h2 class="text-2xl font-bold text-white mb-8">Cronología del bicameralismo en el Perú</h2>
      <ol class="flex flex-col divide-y divide-white/10">
        {timelineEvents.map((event) => (
          <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-4 font-inter">
            <span class="text-white/80 font-bold w-20 shrink-0">{event.year}</span>
            <span class="text-white/70 text-sm leading-6">{event.description}</span>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <!-- CTA -->
  <section class="bg-dark-white-obs py-8">
    <Container>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <p class="font-medium">Explora los representantes elegidos bajo el nuevo sistema bicameral.</p>
        <Button href="/candidatos" variant="outline" size="md" class="rounded-lg">
          Ver representantes
        </Button>
      </div>
    </Container>
  </section>
</Layout>
