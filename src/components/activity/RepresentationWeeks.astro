---
/**
 * RepresentationWeeks — "Semanas de representación 2021–2026" section.
 * Typography, colors and card styles follow the congreso-2021-2026 page (see RepresentationTracker.vue).
 * Content comes from `representation.weeks` in 2021-2026.json.
 */
import usersIcon from '../../assets/icons/users.svg?raw';
import userIcon from '../../assets/icons/user.svg?raw';
import checkIcon from '../../assets/icons/check-circle.svg?raw';
import billIcon from '../../assets/icons/bill.svg?raw';
import calendarIcon from '../../assets/icons/calendar.svg?raw';

import type { WeeksSection, WeeksStatus } from '../../types/previous';

interface Props {
  data: WeeksSection;
}

const { data } = Astro.props;
const { intro, calendar, compliance, groups, qualityCta } = data;

const STATS_ICONS = { user: userIcon, check: checkIcon, users: usersIcon, bill: billIcon };

// Cell color per status (gray = outside the period)
const STATUS_CLASS: Record<WeeksStatus, string> = {
  none: 'bg-[#EEF2F6]',
  ok: 'bg-[#CEE5F2]',
  partial: 'bg-[#F5B700]',
  missing: 'bg-[#D62828]',
};

const formatPercent = (value: number) => `${value.toFixed(1).replace('.', ',')} %`;

const panelClass = 'bg-white border border-[#DCE9F5] rounded-2xl';
const iconClass = '[&>svg]:w-6 [&>svg]:h-6';

// Shared class strings (mirroring the mockup's .panel, h2, .subtitle and .stat-* rules)
const panel = 'bg-white rounded-2xl shadow-sm border border-gray-100';
const panelPadding = 'p-6 max-[600px]:p-4';
const panelTitle = 'mb-1 text-sm font-bold text-primary-black-obs';
const subtitle = 'text-xs text-regular-gray-obs';
const calendarRow =
  'grid grid-cols-[38px_repeat(12,minmax(0,1fr))] gap-2 items-center max-[850px]:gap-[6px] max-[600px]:grid-cols-[32px_repeat(12,minmax(0,1fr))] max-[600px]:gap-1';
const statCard = 'p-3 rounded-xl bg-pill-blue-obs flex items-center gap-3';
const statValue = 'block text-base font-bold text-primary-blue-obs';
const statLabel = 'mt-0.5 text-[10px] leading-snug text-regular-gray-obs';
const roundIcon =
  'rounded-full grid place-items-center shrink-0 bg-pill-blue-obs text-primary-blue-obs [&>svg]:w-[30px] [&>svg]:h-[30px] max-[600px]:w-12 max-[600px]:h-12 max-[600px]:[&>svg]:w-6 max-[600px]:[&>svg]:h-6';
---

<div>
  <header class="mb-4">
    <h2 class="mb-1 text-xl md:text-2xl font-bold text-dark-blue-obs">{data.title}</h2>
    <p class="text-sm text-regular-gray-obs">{data.subtitle}</p>
  </header>

  <!-- Intro -->
  <section class={`${panel} ${panelPadding} grid grid-cols-[66px_1fr] gap-[18px] mb-6 max-[600px]:grid-cols-1 max-[600px]:gap-[10px]`}>
    <div class={`${roundIcon} w-[60px] h-[60px]`} aria-hidden="true" set:html={usersIcon} />
    <div class="[&>p]:text-sm [&>p]:text-primary-gray-obs [&>p]:leading-6 [&>p]:mt-2 [&_a]:text-accent-blue-obs [&_a]:font-semibold hover:[&_a]:underline">
      <h3 class={panelTitle}>{intro.title}</h3>
      {intro.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
    </div>
  </section>

  <div class="grid grid-cols-[1.22fr_1fr] gap-6 mb-6 max-[850px]:grid-cols-1">
    <!-- Calendar -->
    <section class={`${panel} ${panelPadding}`}>
      <h3 class={panelTitle}>{calendar.title}</h3>
      <p class={`${subtitle} mb-4`}>{calendar.subtitle}</p>
      <div
        class="mb-4 grid gap-[7px] max-[600px]:gap-[6px]"
        role="img"
        aria-label="Calendario mensual de semanas de representación de 2021 a 2026"
      >
        <div class={`${calendarRow} mb-1`}>
          <span></span>
          {calendar.months.map((m) => (
            <span class="text-center text-regular-gray-obs text-[9px] font-semibold">{m}</span>
          ))}
        </div>
        {calendar.rows.map((row) => (
          <div class={calendarRow}>
            <b class="text-[10px] text-regular-gray-obs font-normal">{row.year}</b>
            {row.months.map((status) => (
              <i class={`block w-full aspect-square rounded-lg max-[600px]:rounded-[5px] ${STATUS_CLASS[status]}`}></i>
            ))}
          </div>
        ))}
      </div>
      <div class="flex items-start justify-between gap-3 text-regular-gray-obs text-[10px] leading-[1.45] max-[600px]:gap-[7px]">
        {calendar.legend.map((item) => (
          <span class="flex items-start gap-2">
            <i class={`inline-block w-4 h-4 rounded-[5px] shrink-0 max-[600px]:w-3 max-[600px]:h-3 ${STATUS_CLASS[item.status]}`}></i>
            <span>{item.lines.map((line, idx) => <>{idx > 0 && <br />}{line}</>)}</span>
          </span>
        ))}
      </div>
      <div class="mt-4 px-4 py-3 rounded-xl bg-sky-blue-obs border border-light-blue-obs flex items-center gap-3 text-primary-gray-obs text-[11px] leading-relaxed">
        <span class="grid place-items-center w-6 h-6 rounded-full bg-accent-blue-obs text-white text-sm font-bold shrink-0">i</span>
        <p>{calendar.note}</p>
      </div>
    </section>

    <!-- Compliance -->
    <section class={`${panel} ${panelPadding}`}>
      <h3 class={panelTitle}>{compliance.title}</h3>
      <p class={`${subtitle} mb-3`} set:html={compliance.subtitle} />
      <div class="rounded-xl py-4 px-3 text-center text-white bg-primary-blue-obs flex flex-col">
        <strong class="text-4xl leading-none font-bold">{compliance.main.value}</strong>
        <span class="mt-1 text-sm font-semibold">{compliance.main.label}</span>
        <small class="mt-1 text-[11px] text-white/70">{compliance.main.detail}</small>
      </div>
      <div class="grid grid-cols-2 gap-3 mt-3">
        {compliance.stats.map((stat) => (
          <div class={`${statCard} min-h-19`}>
            <span
              class="w-10 h-10 rounded-full bg-white text-primary-blue-obs grid place-items-center shrink-0 [&>svg]:w-5.5 [&>svg]:h-5.5"
              aria-hidden="true"
              set:html={STATS_ICONS[stat.icon]}
            />
            <div>
              <strong class={statValue}>{stat.value}</strong>
              <p class={statLabel}>{stat.label}</p>
            </div>
          </div>
        ))}
        <div class={`${statCard} col-span-full min-h-15.5`}>
          <span
            class="w-10 h-10 grid place-items-center rounded-full bg-red-obs text-white border-[5px] border-sky-red-obs text-xl font-bold shrink-0"
            aria-hidden="true">!</span
          >
          <div>
            <strong class={statValue}>{compliance.alert.value}</strong>
            <p class={statLabel} set:html={compliance.alert.label} />
          </div>
        </div>
      </div>
      <div class="mt-3 px-4 py-3 rounded-xl bg-[#e2f5f2] border border-light-blue-obs text-primary-gray-obs flex items-center gap-3 text-[11px] leading-relaxed">
        <span class="text-accent-blue-obs shrink-0 [&>svg]:w-6.5 [&>svg]:h-6.5" aria-hidden="true" set:html={calendarIcon} />
        <p set:html={compliance.note} />
      </div>
    </section>
  </div>

  <!-- Groups bar chart -->
  <section class={`${panel} ${panelPadding} mb-6`}>
    <h3 class={panelTitle}>{groups.title}</h3>
    <p class={`${subtitle} mb-5`}>{groups.subtitle}</p>
    <div class="grid gap-1.25">
      {groups.series.map((group) => (
        <div class="grid grid-cols-[220px_minmax(0,1fr)_74px] items-center gap-2.5 min-h-5 max-[600px]:grid-cols-[115px_minmax(0,1fr)_48px] max-[600px]:gap-1.5">
          <span class="text-right text-primary-gray-obs text-[11px] leading-tight max-[600px]:text-[9px]">{group.name}</span>
          <div class="h-4 rounded-r-[5px] overflow-hidden max-[600px]:h-[14px]">
            <i
              class={`block h-full rounded-r-[5px] ${group.outlier ? 'bg-[#82c6ed]' : 'bg-primary-blue-obs'}`}
              style={`width:${group.value}%`}
            ></i>
          </div>
          <b class="text-primary-blue-obs text-[11px] font-semibold whitespace-nowrap max-[600px]:text-[9px]">{formatPercent(group.value)}</b>
        </div>
      ))}
    </div>
    <div class="flex justify-between mt-2 mb-4 ml-57.5 mr-18.25 text-gray-icon-obs text-[10px] max-[600px]:ml-30.25 max-[600px]:mr-12 max-[600px]:text-[8px]">
      {groups.ticks.map((tick) => <span>{tick} %</span>)}
    </div>
    <div class="flex items-center gap-3 px-4 py-3 border border-amber-200 rounded-lg bg-yellow-obs text-dark-yellow-obs text-[11px] leading-relaxed">
      <span
        class="w-7 h-7 rounded-full bg-[#f18a00] text-white border-[3px] border-[#ffe2ae] grid place-items-center text-base font-bold shrink-0"
        aria-hidden="true">!</span
      >
      <p set:html={groups.note} />
    </div>
  </section>

  <!-- Quality analysis CTA -->
  <section class={`${panel} ${panelPadding} flex items-center gap-5 max-[600px]:flex-wrap max-[600px]:gap-3`}>
    <div class={`${roundIcon} w-16.5 h-16.5`} aria-hidden="true" set:html={billIcon} />
    <div class="flex-1 max-[600px]:min-w-[calc(100%-65px)]">
      <h3 class={panelTitle}>{qualityCta.title}</h3>
      <p class="text-xs text-regular-gray-obs leading-snug">{qualityCta.text}</p>
    </div>
    <a
      href={qualityCta.url}
      class="border border-primary-blue-obs rounded-lg px-4 py-3 text-primary-blue-obs text-xs font-semibold whitespace-nowrap underline max-[600px]:ml-15 max-[600px]:whitespace-normal"
    >
      {qualityCta.linkLabel} <span aria-hidden="true" class="ml-2.5 text-[18px] no-underline inline-block">↗</span>
    </a>
  </section>
</div>
