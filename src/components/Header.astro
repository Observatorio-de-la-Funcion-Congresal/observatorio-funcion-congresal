---
import Container from './ui/Container.astro';
import Nav from './Nav.astro';
import LogoSrc from '../assets/logo.png?url';
---

<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50 py-4">
  <Container class="flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src={LogoSrc} alt="Observatorio de la Función Congresal" class="h-16 w-auto">
    </a>

    <!-- Desktop nav -->
    <Nav class="hidden md:flex" />

    <!-- Mobile nav -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden p-2 text-gray-600 hover:text-navy-900"
      aria-label="Abrir menú"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </Container>

  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100">
    <Container class="py-4">
      <Nav class="flex-col items-start gap-4" />
    </Container>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
