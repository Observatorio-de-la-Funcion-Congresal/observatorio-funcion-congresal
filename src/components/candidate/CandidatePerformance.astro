---
import Card from '../ui/Card/Card.astro';
import CandidateBarChart from '../charts/CandidateBarChart.vue';
import CandidateRadarChart from '../charts/CandidateRadarChart.vue';

interface Performance {
  attendance: number;
  accomplishment: number;
  session_week: number;
  participation: number;
  projects: number;
  motions: number;
  session_week_percentage: number;
  projects_percentage: number;
  accomplishment_percentage: number;
  vote_priorities_percentage: number;
  motions_percentage: number;
}

interface Props {
  performance: Performance;
}

const { performance } = Astro.props;
---

<Card roundedClass="rounded-2xl" padding={false} class="p-6">
  <h2 class="text-2xl font-bold text-primary-black-obs mb-5">Desempeño General</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Bar chart -->
    <div>
      <p class="text-sm font-medium text-primary-gray-obs mb-3 font-inter">Métricas Principales</p>
      <CandidateBarChart
        projects={performance.projects}
        motions={performance.motions}
        session_week={performance.session_week}
        client:only="vue"
      />
    </div>

    <!-- Radar chart -->
    <div>
      <p class="text-sm font-medium text-primary-gray-obs mb-3 font-inter">Análisis 360°</p>
      <CandidateRadarChart
        session_week_percentage={performance.session_week_percentage}
        projects_percentage={performance.projects_percentage}
        accomplishment_percentage={performance.accomplishment_percentage}
        vote_priorities_percentage={performance.vote_priorities_percentage}
        motions_percentage={performance.motions_percentage}
        client:only="vue"
      />
    </div>
  </div>
</Card>
