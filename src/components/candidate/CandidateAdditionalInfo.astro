---
import Card from '../ui/Card/Card.astro';

interface AdditionalInfo {
  representation_week: number;
  party_change: boolean;
  commission_participation: string;
  campaign_plan_url?: string;
  projects: number;
}

interface Props {
  info: AdditionalInfo;
}

const { info } = Astro.props;
---

<Card roundedClass="rounded-2xl" padding={false} class="p-5">
  <h3 class="font-bold text-primary-black-obs text-xl mb-4 tracking-normal">Información Adicional</h3>

  <div class="flex flex-col gap-4">
    <!-- Semana de representación -->
    <div>
      <div class="flex justify-between text-sm mb-1.5">
        <span class="text-primary-gray-obs">Semana de Representación</span>
        <span class="font-semibold text-primary-black-obs">{info.representation_week}%</span>
      </div>
      <div class="w-full bg-gray-100 rounded-full h-1.5">
        <div
          class="bg-primary-blue-obs h-1.5 rounded-full"
          style={`width: ${Math.min(info.representation_week, 100)}%`}
        />
      </div>
    </div>

    <hr class="border-light-gray-obs/90" />

    <!-- Cambio de partido -->
    <p class="flex items-start justify-between flex-col">
      <span class="text-primary-gray-obs text-sm">Cambio de Partido</span>
      <span class=`font-medium text-green-obs`>
        {info.party_change ? 'Sí' : 'No'}
      </span>
    </p>

    <hr class="border-light-gray-obs/90" />

    <!-- Participación en comisiones -->
    <p class="flex items-start justify-between flex-col">
      <span class="text-primary-gray-obs text-sm">Participación en Comisiones</span>
      <span class="flex items-center gap-1 font-medium text-green-obs">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        {info.commission_participation}
      </span>
    </p>
    
    <hr class="border-light-gray-obs/90" />

    <!-- Numero de proyectos -->
    <p class="flex items-start justify-between flex-col">
      <span class="text-primary-gray-obs text-sm">Numero de proyectos (Autor)</span>
      <span class="flex items-center gap-1 font-medium text-green-obs">
        {info.projects}
      </span>
    </p>
  </div>
</Card>
