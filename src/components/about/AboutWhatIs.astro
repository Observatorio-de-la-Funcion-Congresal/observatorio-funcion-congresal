---
import Container from '../ui/Container.astro';
import downloadIcon from '../../assets/icons/download.svg?raw';
import { METHODOLOGY_URL } from '../../constants';

const stats = [
  { value: '2026', label: 'Año de fundación' },
  { value: '190', label: 'Representantes monitoreados' },
  { value: '+120', label: 'Promesas identificadas Congreso 2026' },
  { value: '6', label: 'Partidos políticos' },
];
---

<section class="bg-[#F7FAFF] pt-10 md:pt-14 pb-0">
  <Container>
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-12 items-start">
      <div class="flex-1">
        <h2 class="text-2xl font-bold mb-4">¿Qué es el Observatorio?</h2>
        <p class="leading-[26px] mb-4 text-primary-gray-obs">
          Somos un equipo interdisciplinario de politólogos, abogados, periodistas y especialistas en
          datos, unidos por la convicción de que la democracia se fortalece con información accesible
          y veraz.
        </p>
        <p class="leading-[26px] mb-6 text-primary-gray-obs">
          En el marco de las elecciones generales 2026 se extrajo la información de promesas de campaña de aquellos
          congresistas que buscaban la reelección en el nuevo congreso bicameral. Posteriormente, 
          con el nuevo congreso bicameral, trabajamos por acercar la información sobre el desempeño y 
          propuestas de los congresistas en ambas cámaras.
        </p>
        <a
          href={METHODOLOGY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-primary-blue-obs font-medium underline"
        >
          Descarga nuestra metodología
          <span class="w-6 h-6 svg-full"><Fragment set:html={downloadIcon} /></span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-4 w-full lg:w-auto lg:min-w-[22rem]">
        {stats.map((stat) => (
          <div class="bg-white shadow rounded-2xl p-6 text-center">
            <p class="text-3xl font-bold text-[#101828] mb-1">{stat.value}</p>
            <p class="text-sm text-primary-gray-obs">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
