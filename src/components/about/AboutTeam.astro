---
import Container from '../ui/Container.astro';

// Contenido de ejemplo: reemplazar por el equipo real cuando esté definido.
const members = [
  {
    name: 'Daniela Urquiaga',
    role: 'Directora Ejecutiva',
    bio: 'Politóloga por la PUCP, máster en Gobierno y Administración Pública por la UCM.',
  },
  {
    name: 'Rodrigo Almenara',
    role: 'Director de Datos',
    bio: 'Estadístico y especialista en ciencia de datos aplicada a política pública.',
  },
  {
    name: 'Valeria Meza',
    role: 'Investigadora Legislativa',
    bio: 'Abogada constitucionalista especializada en derecho parlamentario comparado.',
  },
  {
    name: 'Carlos Huamán',
    role: 'Diseño y Comunicaciones',
    bio: 'Diseñador UX/UI con enfoque en visualización de datos para el sector público.',
  },
];

---

<section class="bg-primary-blue-obs py-12 md:py-16">
  <Container>
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Equipo</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-8">
      {members.map((member) => (
        <div>
          <h3 class="text-sm font-bold text-white mb-1.5">{member.name}</h3>
          <p class="text-xs font-bold text-white/60 mb-2">{member.role}</p>
          <p class="text-xs text-white/50 leading-5">{member.bio}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
