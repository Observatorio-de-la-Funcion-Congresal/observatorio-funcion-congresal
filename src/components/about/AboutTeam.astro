---
import Container from '../ui/Container.astro';

const members = [
  { name: 'Adrian Priale', title: 'Ingeniero de Sistemas', role: 'Voluntario para el desarrollo web de la plataforma' },  
  { name: 'Alex Evanan', title: 'Economista', role: 'Voluntario para la recopilación y análisis de datos' },
  { name: 'Almendra Orbegoso', title: 'Mg. en Diseño de Experiencia de Usuario', role: 'Voluntaria para conducir la investigación en el diseño de la plataforma' },
  { name: 'Alonso Barandiaran', title: 'Lic. en Ciencia Política y Gobierno', role: 'Voluntario para la recopilación y análisis de datos' },
  { name: 'Braulio Arteaga', title: 'Economista', role: 'Voluntario para la recopilación y análisis de datos' },
  { name: 'Daniela Segura', title: 'Comunicadora Social', role: 'Voluntaria encargada del Diseño UX de la plataforma' },
  { name: 'Eduardo Haro', title: 'MPP', role: 'Voluntario para las comunicaciones internas y externas' },
  { name: 'Karen Gonzales', title: 'Diseñadora Gráfica', role: 'Voluntaria encargada del Diseño UI de la plataforma' },
  { name: 'Kiara Momediano', title: 'Comunicadora', role: 'Voluntaria encargada de comunicaciones externas y publicaciones' },
  { name: 'Luis Rodas', title: 'Economista', role: 'Voluntario para la recopilación y análisis de datos' },
  { name: 'Mariapaula Macedo', title: 'Br. en Ciencia Política y Gobierno', role: 'Voluntaria para la recopilación y análisis de datos' },
  { name: 'Marlene Cardenas', title: 'Antropóloga', role: 'Voluntaria para la recopilación y análisis de datos' },
  { name: 'Mauricio Ibañez', title: 'MPP', role: 'Voluntario encargado de la dirección general del proyecto' },
  { name: 'Monica Sanchez', title: 'Abogada', role: 'Voluntaria encargada del diseño del Producto Digital' },
  { name: 'Valeria Arce', title: 'Br. En Administración de Servicios', role: 'Voluntaria para la recopilación y análisis de datos' },
