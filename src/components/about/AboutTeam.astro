---

<section class="bg-primary-blue-obs py-12 md:py-16">
  <Container>
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Equipo</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-8">
      {members.map((member) => (
        <div>
          <h3 class="text-sm font-bold text-white mb-1.5">{member.name}</h3>
          <p class="text-xs font-bold text-white/60 mb-2">{member.title}</p>
          <p class="text-xs text-white/50 leading-5">{member.role}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
