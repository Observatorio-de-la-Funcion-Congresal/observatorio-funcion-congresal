---
import Card from '../ui/Card/Card.astro';

interface Props {
  name: string;
  role?: string;
}

const { name, role = 'Líder del Partido' } = Astro.props;

const initials = name
  .split(' ')
  .filter((w) => w.length > 2 && !['de', 'la', 'el', 'y', 'por', 'del'].includes(w.toLowerCase()))
  .map((w) => w[0]?.toUpperCase())
  .join('')
  .substring(0, 2);
---

<Card class="p-6" roundedClass='rounded-2xl' padding={false}>
  <h3 class="font-bold text-primary-black-obs text-xl mb-4 tracking-normal">Liderazgo</h3>

  <div class="flex items-center gap-3">
    <div class="w-12 h-12 rounded-full bg-primary-blue-obs text-white flex items-center justify-center font-bold shrink-0">
      {initials}
    </div>
    <div class="font-inter min-w-0">
      <p class="font-medium text-primary-black-obs truncate">{name}</p>
      <p class="text-sm text-primary-gray-obs">{role}</p>
    </div>
  </div>
</Card>
