---
/**
 * Nav component — horizontal list of navigation links.
 * Accepts an array of { label, href } items via props or uses defaults.
 */
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items?: NavItem[];
  class?: string;
}

const defaultItems: NavItem[] = [
  { label: 'Bicameralidad', href: '/bicameralidad' },
  { label: 'Congresistas', href: '/congresistas' },
  { label: 'Partidos políticos', href: '/partidos' },
  { label: 'Actividad del congreso', href: '/actividad-del-congreso' }
];

const startWithSlash = (path: string) => path.startsWith('/');

const { items = defaultItems, class: className = '' } = Astro.props;

const currentPath = Astro.url.pathname;
---

<nav class={`flex items-center gap-8 ${className}`} aria-label="Menú principal">
  {
    items.map((item) => (
      <a
        href={item.href}
        class={[
          'text-sm font-medium transition-colors hover:text-navy-900',
          currentPath === item.href
            ? 'text-navy-900 border-b-2 border-navy-900 pb-0.5'
            : 'text-gray-600',
        ].join(' ')}
        target={startWithSlash(item.href) ? '_self' : '_blank'}
        rel={startWithSlash(item.href) ? undefined : 'noopener noreferrer'}
      >
        {item.label}
      </a>
    ))
  }
</nav>
