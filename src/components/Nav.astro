---
/**
 * Nav component — horizontal list of navigation links.
 * Accepts an array of { label, href } items via props or uses defaults.
 * Items can also define `children` to render as a submenu (dropdown on desktop, inline list on mobile).
 */
interface NavChild {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  href?: string;
  children?: NavChild[];
}

interface Props {
  items?: NavItem[];
  class?: string;
  mobile?: boolean;
}

const defaultItems: NavItem[] = [
  {
    label: 'Bicameralidad',
    children: [
      { label: 'Conoce tu congreso', href: '/bicameralidad' },
      { label: 'Glosario', href: '#' },
      { label: 'Ruta de proyecto de ley', href: '#' }
    ]
  },
  { label: 'Congresistas', href: '/congresistas' },
  { label: 'Partidos políticos', href: '/partidos' },
  { label: 'Actividad del congreso', href: '/actividad-congreso' }
];

const startWithSlash = (path: string) => path.startsWith('/');

const { items = defaultItems, class: className = '', mobile = false } = Astro.props;

const currentPath = Astro.url.pathname;
---

<nav class={`${mobile ? 'flex flex-col' : 'flex items-center'} gap-8 ${className}`} aria-label="Menú principal">
  {
    items.map((item) => {
      const isParentActive = item.children?.some((child) => child.href === currentPath) ?? false;

      if (item.children && mobile) {
        return (
          <div class="flex flex-col gap-2">
            <span class={`text-sm font-medium ${isParentActive ? 'text-navy-900' : 'text-gray-600'}`}>
              {item.label}
            </span>
            <div class="flex flex-col gap-2 pl-4">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class={[
                    'text-sm transition-colors hover:text-navy-900',
                    currentPath === child.href ? 'text-navy-900 font-medium' : 'text-gray-500',
                  ].join(' ')}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        );
      }

      if (item.children) {
        return (
          <div class="relative">
            <button
              type="button"
              data-nav-toggle
              class={[
                'flex items-center gap-1 text-sm font-medium transition-colors hover:text-navy-900 cursor-pointer',
                isParentActive ? 'text-navy-900 border-b-2 border-navy-900 pb-0.5' : 'text-gray-600',
              ].join(' ')}
            >
              {item.label}
              <svg
                data-nav-chevron
                class="h-3.5 w-3.5 transition-transform"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>
            <div
              data-nav-panel
              class="hidden absolute left-0 top-full mt-4 min-w-55 rounded-xl border border-gray-100 bg-white py-2 shadow-lg"
            >
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class={[
                    'block px-4 py-2 text-sm transition-colors hover:bg-gray-50',
                    currentPath === child.href ? 'bg-blue-50 font-semibold text-navy-900' : 'text-gray-600',
                  ].join(' ')}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        );
      }

      return (
        <a
          href={item.href}
          class={[
            'text-sm font-medium transition-colors hover:text-navy-900',
            currentPath === item.href
              ? 'text-navy-900 border-b-2 border-navy-900 pb-0.5'
              : 'text-gray-600',
          ].join(' ')}
          target={startWithSlash(item.href!) ? '_self' : '_blank'}
          rel={startWithSlash(item.href!) ? undefined : 'noopener noreferrer'}
        >
          {item.label}
        </a>
      );
    })
  }
</nav>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]').forEach((btn) => {
    const panel = btn.parentElement?.querySelector('[data-nav-panel]');
    const chevron = btn.querySelector('[data-nav-chevron]');
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      panel?.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('[data-nav-panel]:not(.hidden)').forEach((panel) => panel.classList.add('hidden'));
    document.querySelectorAll('[data-nav-chevron].rotate-180').forEach((chevron) => chevron.classList.remove('rotate-180'));
  });
</script>
