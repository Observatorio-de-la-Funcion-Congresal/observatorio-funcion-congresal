---
import Container from '../ui/Container.astro';
import Card from '../ui/Card/Card.astro';
import type { MotionsSection } from '../../types/previous';
import { fmtInt } from '../../lib/format';

interface Props {
  data: MotionsSection;
}

const { data } = Astro.props;
---

<section class="pt-12 md:pt-14">
  <Container>
    <h2 class="text-xl md:text-2xl font-bold text-dark-blue-obs mb-2">{data.title}</h2>
    <p class="text-sm text-regular-gray-obs mb-6">{data.description}</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      {
        data.cards.map((card) => (
          <Card padding={false} roundedClass="rounded-2xl" class="p-5">
            <h3 class="text-xs font-bold text-primary-black-obs mb-3 flex items-center gap-1">
              {card.title}
              {card.info && (
                <span class="text-gray-icon-obs cursor-help" title={card.info} aria-label={card.info}>ⓘ</span>
              )}
            </h3>
            <div class="bg-pill-blue-obs rounded-xl px-4 py-3 mb-4 flex items-baseline gap-2">
              <span class="text-2xl font-bold text-primary-blue-obs">{fmtInt(card.total)}</span>
              <span class="text-[10px] font-semibold uppercase tracking-wide text-accent-blue-obs">presentadas</span>
            </div>

            {card.breakdown && card.breakdown.length > 0 && (
              <>
                <div class="flex h-2 rounded-full overflow-hidden mb-3">
                  {card.breakdown.map((b) => (
                    <div style={`width:${(b.count / card.total) * 100}%;background:${b.color}`} />
                  ))}
                </div>
                <ul class="flex flex-col gap-1 text-[11px] text-primary-gray-obs">
                  {card.breakdown.map((b) => (
                    <li class="flex items-center gap-1.5 flex-wrap">
                      <span class="w-2 h-2 rounded-full shrink-0" style={`background:${b.color}`} />
                      <strong class="font-semibold text-primary-black-obs">{fmtInt(b.count)}</strong>
                      {b.label}
                      {b.badge && (
                        <span class="text-[9px] bg-yellow-obs text-dark-yellow-obs border border-amber-200 rounded px-1.5 py-0.5">
                          {b.badge}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </>
            )}

            {card.items && (
              <>
                <ul class="flex flex-col text-[11px] text-primary-gray-obs mb-3">
                  {card.items.map((item) => (
                    <li class="flex items-center justify-between py-1 border-b border-lighter-border-gray-obs last:border-0">
                      {item.label}
                      <strong class="font-semibold text-primary-blue-obs">{fmtInt(item.count)}</strong>
                    </li>
                  ))}
                </ul>
                {card.warning && (
                  <p class="text-[9px] uppercase text-dark-yellow-obs bg-yellow-obs border border-amber-200 rounded-lg px-3 py-2">
                    {card.warning}
                  </p>
                )}
              </>
            )}
          </Card>
        ))
      }
    </div>

    <p class="text-xs md:text-sm text-accent-blue-obs bg-sky-blue-obs border border-light-blue-obs rounded-xl px-4 py-3">
      <strong>En simple:</strong> {data.note}
    </p>
  </Container>
</section>
