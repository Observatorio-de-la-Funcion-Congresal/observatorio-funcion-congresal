---
import Container from '../ui/Container.astro';
import Card from '../ui/Card/Card.astro';
import PartyPieChart from '../charts/PartyPieChart.vue';
import type { CompositionSection } from '../../types/previous';

interface Props {
  data: CompositionSection;
}

const { data } = Astro.props;
---

<section class="pt-12 md:pt-14">
  <Container>
    <h2 class="text-xl md:text-2xl font-bold text-dark-blue-obs mb-3">Composición del Congreso 2021–2026</h2>
    <p class="text-sm text-primary-gray-obs mb-6 max-w-4xl">{data.description}</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <Card padding={false} roundedClass="rounded-2xl" class="p-6">
        <h3 class="text-sm font-semibold text-primary-gray-obs mb-6">Al inicio del período</h3>
        <PartyPieChart client:visible composition={data.start} showSeatsInLegend />
      </Card>
      <Card padding={false} roundedClass="rounded-2xl" class="p-6">
        <h3 class="text-sm font-semibold text-primary-gray-obs mb-6">Al cierre del período</h3>
        <PartyPieChart client:visible composition={data.end} />
      </Card>
    </div>

    <p class="text-xs md:text-sm text-accent-blue-obs bg-sky-blue-obs border border-light-blue-obs rounded-xl px-4 py-3">
      <strong>En simple:</strong> {data.note}
    </p>
  </Container>
</section>
