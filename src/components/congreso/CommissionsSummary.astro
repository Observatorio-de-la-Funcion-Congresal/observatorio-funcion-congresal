---
import Container from '../ui/Container.astro';
import Card from '../ui/Card/Card.astro';
import CommissionsAverage from './CommissionsAverage.vue';
import type { CommissionsSection } from '../../types/previous';

interface Props {
  data: CommissionsSection;
}

const { data } = Astro.props;
const maxPresidencies = Math.max(...data.presidencies.series.map((s) => s.value));
---

<section class="pt-12 md:pt-14">
  <Container>
    <h2 class="text-xl md:text-2xl font-bold text-dark-blue-obs mb-6">{data.title}</h2>

    <Card padding={false} roundedClass="rounded-2xl" class="p-6 mb-6">
      <h3 class="text-sm font-bold text-accent-blue-obs mb-3">{data.intro.question}</h3>
      <p class="text-sm text-primary-gray-obs leading-6 mb-5">{data.intro.text}</p>
      <p class="text-sm font-semibold text-primary-blue-obs mb-3">Total de comisiones: {data.total}</p>
      <ul class="flex flex-wrap gap-2">
        {
          data.names.map((name) => (
            <li class="text-[11px] text-primary-gray-obs border border-lighten-gray-obs rounded-md px-2 py-0.5">{name}</li>
          ))
        }
      </ul>
    </Card>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <CommissionsAverage client:visible data={data.average} />

      <Card padding={false} roundedClass="rounded-2xl" class="p-6">
        <h3 class="text-sm font-bold text-primary-black-obs mb-1">{data.presidencies.title}</h3>
        <p class="text-xs text-regular-gray-obs mb-5">{data.presidencies.subtitle}</p>
        <ul class="flex flex-col gap-2 mb-5">
          {
            data.presidencies.series.map((s) => (
              <li class="flex items-center gap-3 text-[11px] text-primary-gray-obs">
                <span class="w-32 shrink-0 truncate">{s.party}</span>
                <span class="flex-1 h-2.5 bg-lighten-gray-obs rounded-full overflow-hidden">
                  <span class="block h-full rounded-full" style={`width:${(s.value / maxPresidencies) * 100}%;background:${s.color}`} />
                </span>
                <span class="w-6 text-right font-semibold" style={`color:${s.color}`}>{s.value}</span>
              </li>
            ))
          }
        </ul>
        <p class="text-xs text-accent-blue-obs bg-sky-blue-obs border border-light-blue-obs rounded-xl px-4 py-3">
          {data.presidencies.insight}
        </p>
      </Card>
    </div>
  </Container>
</section>
