---
import { HAS_CONGRESISTA_ACTIVITY_DATA } from '../../constants';

interface Props {
  id: number;
  picture: string;
  name: string;
  region: string;
  party: string;
  partyId: number;
  attendance: number;
  abstentions?: number;
  commissionsCount?: number;
  projects: number;
  applyTo: string;
  pictureBase: string;
  partyPicture?: string;
  partyPictureBase: string;
  shadow?: boolean;
  motions?: number;
  hasData?: boolean;
}

const {
  id,
  picture,
  name,
  region,
  party,
  attendance,
  abstentions,
  commissionsCount,
  projects,
  applyTo,
  pictureBase,
  partyPicture,
  partyPictureBase,
  shadow = true,
  hasData = HAS_CONGRESISTA_ACTIVITY_DATA,
} = Astro.props;

const photoUrl = `${pictureBase}${picture}`;
const partyLogoUrl = `${partyPictureBase}${partyPicture}`;
---

<article
  class={`bg-white rounded-2xl border border-gray-100 p-5 flex flex-col gap-4 transition-shadow ${shadow ? 'shadow-sm' : ''}`}
  data-name={name.toLowerCase()}
  data-party={party.toLowerCase()}
  data-region={region.toLowerCase()}
  data-apply-to={applyTo.toLowerCase()}
>
  <!-- Header: photo + info -->
  <div class="flex items-start gap-4">
    <div class="w-20 h-20 rounded-full overflow-hidden bg-gray-200 border-2 border-gray-100">
      <img
        src={photoUrl}
        alt={`Foto de ${name}`}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="font-semibold text-primary-black-obs text-lg">
        <p class="hover:underline">
          {name}
        </p>
      </h3>
      <!-- Party -->
      <div class="flex items-center gap-1.5 mt-1">
        <span class="text-sm text-primary-blue-obs">{party}</span>
      </div>
      <div class="flex items-center gap-2 mt-2">
        {
          applyTo === 'Senador' ? (
            <span class="text-xs bg-lighten-gray-obs py-1 px-2 text-primary-gray-obs rounded-2xl">
              {applyTo}
            </span>
          ) : (
            <span class="text-xs bg-sky-blue-obs py-1 px-2 text-primary-blue-obs rounded-2xl">
              {applyTo}
            </span>    
          )
        }
        <!-- Region -->
        <div class="flex items-center gap-0.5">
          <svg class="w-3 h-3 text-primary-gray-obs shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
          <span class="text-xs text-primary-gray-obs truncate">{region}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats -->
  {
    hasData ? (
      <div class="flex flex-col gap-3">
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-sky-blue-obs rounded-xl p-3">
            <p class="text-xs text-primary-blue-obs mb-1 font-medium">Asistencia</p>
            <p class="text-base font-bold text-primary-blue-obs">{attendance}%</p>
          </div>
          <div class="bg-red-100 rounded-xl p-3">
            <p class="text-xs text-red-600 mb-1 font-medium">Abstenciones</p>
            <p class="text-base font-bold text-red-600">{abstentions}%</p>
          </div>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class={`flex items-center gap-1 ${(commissionsCount ?? 0) > 0 ? 'text-green-600' : 'text-primary-gray-obs'}`}>
            {(commissionsCount ?? 0) > 0 && (
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6L9 17l-5-5" />
              </svg>
            )}
            En comisiones
          </span>
          <span class="text-primary-gray-obs">{projects} proyectos</span>
        </div>
      </div>
    ) : (
      <div class="bg-lighter-border-gray-obs rounded-lg p-3 text-center">
        <p class="text-xs font-inter text-regular-gray-obs">Datos de actividad no disponibles aún</p>
      </div>
    )
  }
</article>
