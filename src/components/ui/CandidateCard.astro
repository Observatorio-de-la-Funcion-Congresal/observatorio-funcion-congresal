---
interface Props {
  id: number;
  picture: string;
  name: string;
  region: string;
  party: string;
  partyId: number;
  attendance: number;
  projects: number;
  applyTo: string;
  pictureBase: string;
  partyPicture?: string;
  partyPictureBase: string;
  shadow?: boolean;
  motions?: number;
}

const { id, picture, name, region, party, attendance, projects, applyTo, pictureBase, partyPicture, partyPictureBase, shadow = true, motions } = Astro.props;

const photoUrl = `${pictureBase}${picture}`;
const partyLogoUrl = `${partyPictureBase}${partyPicture}`;
---

<article
  class={`bg-white rounded-2xl border border-gray-100 p-5 flex flex-col gap-4 transition-shadow ${shadow ? 'shadow-sm' : ''}`}
  data-name={name.toLowerCase()}
  data-party={party.toLowerCase()}
  data-region={region.toLowerCase()}
  data-apply-to={applyTo.toLowerCase()}
>
  <!-- Header: photo + info -->
  <div class="flex items-start gap-4">
    <div class="w-20 h-20 rounded-full overflow-hidden bg-gray-200 border-2 border-gray-100">
      <img
        src={photoUrl}
        alt={`Foto de ${name}`}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="font-semibold text-primary-black-obs text-lg">
        <a href={`/candidato/${id}`} class="hover:underline">
          {name}
        </a>
      </h3>
      <!-- Party -->
      <div class="flex items-center gap-1.5 mt-1">
        <img
            src={partyLogoUrl}
            alt={party}
            class="w-5 h-5 rounded-full object-cover shrink-0 border border-gray-200"
        />
        <span class="text-sm text-primary-blue-obs">{party}</span>
      </div>
      <!-- Region -->
      <div class="flex items-center gap-1.5 mt-0.5">
        <svg class="w-3 h-3 text-primary-gray-obs shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
          <circle cx="12" cy="9" r="2.5"/>
        </svg>
        <span class="text-xs text-primary-gray-obs truncate">{region}</span>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 gap-3">
    <div class="bg-sky-blue-obs rounded-xl p-3">
      <p class="text-xs text-primary-blue-obs mb-1 font-medium">Mociones</p>
      <p class="text-base font-bold text-primary-blue-obs">{motions}</p>
    </div>
    <div class="bg-yellow-obs rounded-xl p-3">
      <p class="text-xs text-dark-yellow-obs mb-1 font-medium">Proyectos</p>
      <p class="text-base font-bold text-dark-yellow-obs">{projects}</p>
    </div>
  </div>

  <!-- Footer -->
  <div class="flex items-center justify-between">
    {
      applyTo === 'Senador' ? (
        <span class="text-xs bg-light-gray-obs py-1 px-2 text-primary-gray-obs rounded-2xl">
          Se postula a {applyTo}
        </span>
      ) : (
        <span class="text-xs bg-sky-blue-obs py-1 px-2 text-primary-blue-obs rounded-2xl">
          Se postula a {applyTo}
        </span>    
      )
    }
    <a
      href={`/candidato/${id}`}
      class="flex items-center gap-1 text-xs text-dark-blue-obs hover:underline"
    >
      Ver perfil
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>
