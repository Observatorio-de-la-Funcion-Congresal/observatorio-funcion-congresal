---
interface Props {
  class?: string;
  shadow?: boolean;
  padding?: boolean;
}

const { class: className = '', shadow = true, padding = true } = Astro.props;

const shadowClass = shadow ? 'shadow-md' : '';
const paddingClass = padding ? 'p-8' : '';
---

<div class={['bg-white rounded-3xl', shadowClass, paddingClass, className].filter(Boolean).join(' ')}>
  <slot />
</div>
