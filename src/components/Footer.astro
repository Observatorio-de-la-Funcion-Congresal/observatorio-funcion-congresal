---
import Container from './ui/Container.astro';
import LogoSrc from '../assets/logo-white.png?url';
import fbIcon from '../assets/icons/fb_Icon.svg?raw';
import lnIcon from '../assets/icons/ln_Icon.svg?raw';
import inIcon from '../assets/icons/in_Icon.svg?raw';

interface FooterLink {
  label: string;
  href: string;
}

const contentLinks: FooterLink[] = [
  { label: 'Sobre la bicameralidad', href: '/bicameralidad' },
  /* { label: 'Conoce los partidos políticos', href: '/partidos' }, */
  { label: 'Compara a tu candidato', href: '/compara' },
  { label: 'Metodología', href: '/metodologia' },
];

const socialLinks = [
  { label: 'Facebook', href: 'https://www.facebook.com/profile.php?id=61554881523426', icon: fbIcon },
  /* { label: 'LinkedIn', href: '#', icon: lnIcon }, */
  { label: 'Instagram', href: 'https://www.instagram.com/observatucongresope/', icon: inIcon },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-dark-blue-obs text-white">
  <Container class="py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div class="flex flex-col gap-4">
        <div>
          <img src={LogoSrc} alt="" class="h-14 w-auto" loading="lazy">
        </div>
        <div class="text-sm leading-5 font-inter text-light-gray-obs opacity-80 font-normal max-w-sm">
          <p class="block mb-1">
            Plataforma de transparencia política que promueve la participación ciudadana informada en el proceso democrático peruano.
          </p>
          <p class="block opacity-90">
            Apoyo técnico de <a target="_blank" rel="noopener noreferrer" href="https://www.openperu.org.pe" class="hover:underline hover:opacity-100">Open Perú</a>
          </p>
        </div>
        
        <div class="flex items-center gap-3 mt-2">
          {
            socialLinks.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                class="w-8 h-8 flex items-center justify-center rounded-lg p-2 bg-white/10 border border-transparent hover:border-primary-gray-obs"
              >
                <Fragment set:html={s.icon} />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h4 class="text-lg font-bold mb-4 text-white">Contenido</h4>
        <ul class="text-light-gray-obs">
          {
            contentLinks.map((link) => (
              <li class="text-sm mb-3">
                <a href={link.href} class="opacity-80 hover:opacity-100 transition-opacity">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>

  <div>
    <Container class="py-4 border-t border-white/10">
      <p class="text-sm text-light-gray-obs font-inter opacity-80">
        © {currentYear} Bicameralidad Perú. Plataforma de transparencia política ciudadana.
      </p>
    </Container>
  </div>
</footer>
