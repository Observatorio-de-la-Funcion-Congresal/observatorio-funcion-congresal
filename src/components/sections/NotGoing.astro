---
import Container from "../ui/Container.astro";

const URL_PARTY_PICTURE = import.meta.env.URL_PARTY_PICTURE;

interface NotGoingItem {
  id?: string | number;
  image: string;
  title: string;
}

interface Props {
  heading?: string;
  body?: string;
  notGoing?: NotGoingItem[];
}

const {
  heading = "Partidos que no continúan",
  body = "Estos partidos no alcanzaron la valla electoral o no tuvieron escaños para el período 2026-2031.",
  notGoing = [
    { id: 3, image: "1257.jpg", title: "Alianza Para El Progreso" },
    { id: 7, image: "14.jpg", title: "Somos Perú" },
    { id: 13, image: "2731.jpg", title: "Podemos Perú" },
    { id: 4, image: "2173.jpg", title: "Avanza País" },
    { id: 10, image: "2218.jpg", title: "Perú Libre" },
    { id: 0, image: "2840.jpg", title: "Partido Morado" },
    { id: 0, image: "acc-p.png", title: "Acción Popular" },
  ],
} = Astro.props;
---

<section class="bg-white py-14">
  <Container>
    <div class="text-center mb-12">
      <h2
        class="text-3xl md:text-4xl font-extrabold text-primary-black-obs mb-4"
      >
        {heading}
      </h2>
      <p class="text-gray-600 text-base max-w-2xl mx-auto">{body}</p>
    </div>

    <div class="flex flex-wrap justify-center gap-x-8 gap-y-6">
      {
        notGoing.map((item) => (
          <div class="flex items-center gap-3 w-full sm:w-[calc(50%-16px)] lg:w-[calc(25%-24px)]">
            <img
              src={`${URL_PARTY_PICTURE}${item.image}`}
              alt=""
              class="w-16 h-16"
            />
            <p class="text-base font-semibold text-primary-blue-obs">
              {item.title}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
