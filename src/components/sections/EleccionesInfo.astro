---
import Card from '../ui/Card/Card.astro';
import Container from '../ui/Container.astro';

interface EleccionItem {
  label: string;
}

interface Props {
  sectionTitle?: string;
  whenTitle?: string;
  whenBody?: string;
  weChose?: EleccionItem[];
  importanceTitle?: string;
  importanceBody?: string;
  remember?: EleccionItem[];
}

const {
  sectionTitle = 'Elecciones 2026',
  whenTitle = '¿Cuándo votamos?',
  whenBody = [
    'Las elecciones generales se llevarán a cabo el ',
    '<span class="font-bold">11 de abril de 2026</span>',
    ' en todo el territorio nacional.',
  ].join(''),
  weChose = [
    { label: 'Presidente y Vicepresidentes' },
    { label: '130 Diputados al Congreso' },
    { label: '60 Senadores' },
    { label: '5 Parlamentarios Andinos' },
  ],
  importanceTitle = 'Tu voto importa',
  importanceBody = 'Por primera vez en décadas, los peruanos elegiremos un Congreso bicameral. Tu participación es fundamental para fortalecer la democracia.',
  remember = [
    { label: 'El voto es universal y obligatorio' },
    { label: 'Conoce a tus candidatos' },
    { label: 'Vota informado y consciente' },
    { label: 'Exige rendición de cuentas' },
  ],
} = Astro.props;
---

<section class="py-14">
  <Container>
    <Card padding={false} class="overflow-hidden">
      <div class="py-6 px-8 bg-primary-blue-obs">
        <h2 class="text-3xl font-bold text-white">{sectionTitle}</h2>
      </div>
  
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 p-8">
        <!-- When vote -->
        <div class="flex flex-col gap-4">
          <h3 class="text-lg font-bold">{whenTitle}</h3>
          <p class="text-primary-gray-obs">
            <Fragment set:html={whenBody} />
          </p>
  
          <div class="bg-sky-blue-obs rounded-xl p-4 mt-6">
            <p class="font-bold mb-3 text-secondary-blue-obs">Elegiremos:</p>
            <ul class="list-check ml-3">
              {
                weChose.map((item) => (
                  <li class="text-sm mb-2">
                    <span class="ml-2">{item.label}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
  
        <!-- Your vote matters -->
        <div class="flex flex-col gap-4">
          <h3 class="text-lg font-bold">{importanceTitle}</h3>
          <p class="text-primary-gray-obs">{importanceBody}</p>
  
          <div class="bg-sky-red-obs rounded-xl p-4">
            <p class="font-bold mb-3 text-dark-red-obs">Recuerda:</p>
            <ul class="list-check ml-3 text-dark-red-obs">
              {
                remember.map((item) => (
                  <li class="text-sm mb-2">
                    <span class="ml-2">{item.label}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </Card>
  </Container>
</section>
