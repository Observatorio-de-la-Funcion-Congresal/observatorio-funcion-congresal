---
import Container from '../ui/Container.astro';
import CongressCompositionCharts from './CongressCompositionCharts.astro';

interface Props {
  eyebrow?: string;
}

const {
  eyebrow = 'Nueva composición'
} = Astro.props;
---

<section class="bg-sky-blue-obs py-20 text-center">
  <Container>
    <p class="text-3xl font-bold flex flex-col gap-2">
      {eyebrow}
    </p>
    <CongressCompositionCharts />
  </Container>
</section>
