---
/**
 * Hero section — dark background with heading, subtitle, and CTA buttons.
 *
 * Props allow full customisation so this can be reused on other pages
 * by swapping headline, sub-text, or the two button labels/hrefs.
 */
import Container from '../ui/Container.astro';
import Button from '../ui/Button/Button.astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  headingItalic?: string;
  headingItalicPrefix?: string;
  headingEnd?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading = 'El Congreso del Perú,\nexplicado para todos',
  body = 'Información confiable, actualizada e independiente sobre el nuevo sistema bicameral, sus representantes, actividad legislativa y promesas de campaña.',
  primaryLabel = 'Ver la actividad del congreso',
  primaryHref = '/actividad-del-congreso',
} = Astro.props;
---

<section class="relative flex items-center bg-navy-900 overflow-hidden">
  <div class="absolute inset-0 bg-[url('/src/assets/hero-background.jpg')] bg-cover saturate-0"></div>
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-hero-overlay mix-blend-multiply"></div>

  <Container class="relative z-10 py-25 text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6 max-w-3xl mx-auto">
      {heading}
    </h1>

    <p class="text-white text-base leading-6 mx-auto mb-10 whitespace-pre-line md:max-w-7/12">
      {body}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href={primaryHref} variant="secondary" size="lg" class="rounded-2xl">
        {primaryLabel}
      </Button>
    </div>
  </Container>
</section>
