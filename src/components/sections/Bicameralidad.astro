---
import Container from '../ui/Container.astro';
import Card from '../ui/Card/Card.astro';

interface ChamberItem {
  icon: string;
  title: string;
  bullets: string[];
}

interface CharacteristicItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  heading?: string;
  body?: string;
  chambers?: ChamberItem[];
  characteristics?: {
    name: string;
    items: CharacteristicItem[];
  };
}

const {
  heading = '¿Qué es la Bicameralidad?',
  body = 'La bicameralidad es un sistema legislativo donde el poder legislativo está dividido en dos cámaras independientes que trabajan en conjunto para crear leyes.',
  chambers = [
    {
      icon: 'diputados_icon.svg',
      title: 'Diputados',
      bullets: [
        '<span class="font-bold">130 diputados</span> elegidos por voto popular',
        'Representan a <span class="font-bold">todas las regiones del país</span>',
        'Funciones: iniciativa legislativa, fiscalización y presupuesto',
        'Cámara de origen para leyes económicas y tributarias',
      ],
    },
    {
      icon: 'senado_icon.svg',
      title: 'Senado',
      bullets: [
        '<span class="font-bold">60 senadores</span> elegidos por circunscripción nacional',
        'Visión más <span class="font-bold">nacional y de largo plazo</span>',
        'Funciones: revisión de leyes, ratificación de tratados',
        'Cámara de origen para reformas constitucionales',
      ],
    },
  ],
  characteristics = {
    name: 'Características de la Bicameralidad',
    items: [
      {
        icon: 'balance_icon.svg',
        title: 'Mayor Control',
        description: 'Doble revisión de las leyes para garantizar su calidad',
      },
      {
        icon: 'deal_icon.svg',
        title: 'Representación Dual',
        description: 'Regional en Diputados, nacional en Senadores',
      },
      {
        icon: 'shield_icon.svg',
        title: 'Contrapesos',
        description: 'Sistema de equilibrios que evita abusos de poder',
      }
    ]
  }
} = Astro.props;
---

<section class="bg-white py-14">
  <Container>
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-primary-black-obs mb-4">{heading}</h2>
      <p class="text-gray-600 text-base max-w-2xl mx-auto">{body}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        chambers.map((chamber) => (
          <Card class="border border-gray-100 flex flex-col gap-4">
            <div class="flex items-center justify-start rounded-lg">
              <img src={"/assets/icons/" + chamber.icon} alt="" class="w-16 h-16"  loading="lazy" />
            </div>
            <h3 class="text-2xl font-bold text-gray-900">{chamber.title}</h3>
            <ul class="list-disc pl-5">
              {chamber.bullets.map((bullet) => (
                <li class="text-primary-gray-obs mb-2">
                  <Fragment set:html={bullet} />
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
    <div class="bg-sky-blue-obs rounded-3xl p-8 mt-8">
      <h3 class="text-2xl text-center font-bold text-gray-900 mb-8 mx-auto">{characteristics.name}</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          characteristics.items.map((item) => (
            <div class="flex flex-col items-center text-center gap-2">
              <img src={"/assets/icons/" + item.icon} alt="" class="w-12 h-12" loading="lazy" />
              <h4 class="text-base font-bold">{item.title}</h4>
              <p class="text-primary-gray-obs text-sm">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>
