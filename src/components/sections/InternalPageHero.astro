---
import Container from '../ui/Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  subtitleClass?: string;
}

const { eyebrow, title, subtitle, subtitleClass = 'text-white/60 text-base font-inter' } = Astro.props;
---

<section class="bg-primary-blue-obs py-16">
  <Container>
    {eyebrow && <span class="block text-xs font-semibold tracking-wide text-white/70 uppercase mb-3">{eyebrow}</span>}
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h1>
    <p class={subtitleClass}>{subtitle}</p>
  </Container>
</section>
