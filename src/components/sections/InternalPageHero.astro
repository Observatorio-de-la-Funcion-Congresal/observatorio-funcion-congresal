---
import Container from '../ui/Container.astro';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-primary-blue-obs py-12">
  <Container>
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h1>
    <p class="text-light-blue-obs text-base md:text-lg">{subtitle}</p>
  </Container>
</section>
