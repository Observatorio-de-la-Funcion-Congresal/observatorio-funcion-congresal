---
import Container from '../ui/Container.astro';

interface Props {
  title: string;
  subtitle?: string;
  subtitleClass?: string;
}

const { title, subtitle, subtitleClass = 'text-white/60 text-base font-inter' } = Astro.props;
---

<section class="bg-primary-blue-obs py-16">
  <Container>
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h1>
    <p class={subtitleClass}>{subtitle}</p>
  </Container>
</section>
