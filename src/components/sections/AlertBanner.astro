---
import Button from '../ui/Button.astro';
---

<div class={`bg-red-obs text-white`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-4 flex-wrap">
    <p class="text-sm font-medium">
      Faltan
      <strong class="font-bold text-lg"> <span id="countdown-days">--</span> días</strong>
      para el
      <strong class="font-bold"> 7 de junio.</strong>
      {' '}El voto informado es tu derecho y tu poder.
    </p>
    <Button href="/candidatos" variant="outline-light" size="sm">
      Ver desempeño
    </Button>
  </div>
</div>

<script>
  const targetDate = new Date('2026-06-07');

  function updateCountdown() {
    const now = new Date();
    const diff = targetDate.getTime() - now.getTime();

    const daysEl = document.getElementById('countdown-days');

    if (diff <= 0) {
      if (daysEl) daysEl.textContent = '0';
      return;
    }

    const days = Math.ceil(diff / (1000 * 60 * 60 * 24));

    if (daysEl) daysEl.textContent = String(days);
  }

  updateCountdown();
</script>
