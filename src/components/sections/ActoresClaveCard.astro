---
import Card from '../ui/Card/Card.astro';
import Icon from '../ui/Icon/Icon.astro';

interface Actor {
  name: string;
  description: string;
  icon?: string;
  rawIcon?: string;
  badgeClass?: string;
}

interface Props {
  title?: string;
  actors: Actor[];
}

const { title = 'Actores Clave', actors } = Astro.props;
---

<Card roundedClass="rounded-xl" class="lg:sticky lg:top-24">
  <h3 class="mb-4 border-b border-lighter-border-gray-obs pb-3 font-bold text-primary-black-obs">{title}</h3>
  <ul class="flex flex-col gap-4">
    {actors.map((actor) => (
      <li class="flex gap-3">
        <span
          class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${actor.badgeClass ?? 'bg-sky-blue-obs'}`}
        >
          {actor.icon && <Icon icon={actor.icon} class="h-4 w-4 text-primary-gray-obs" />}
          {actor.rawIcon && <span class="svg-full h-4 w-4" set:html={actor.rawIcon} />}
        </span>
        <div>
          <p class="text-sm font-bold text-primary-black-obs">{actor.name}</p>
          <p class="text-xs leading-5 text-primary-gray-obs">{actor.description}</p>
        </div>
      </li>
    ))}
  </ul>
</Card>
